# Guix build outputs
/result
/result-*

# A site entry carries the real credential hash and the site facts (overlay
# zones, gateway MACs).  Only *.example files are tracked: copy one, keep the
# copy out of git.
/appliances/*/site.scm

# Geodata is fetched per build host, not committed (large, changes often)
/geodata/

# Local scratch
.env
*.tmp
